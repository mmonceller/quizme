// Deployed on the Cloudflare Workers Free plan. Everything here is available without a
// payment method; if a daily free limit is reached, requests fail until the reset instead
// of being billed. Avoid adding R2, Queues, or other paid-only bindings.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quizgame",
  "main": "server/src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these paths run the Worker; all other static files are served for free.
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "vars": {
    // Sites on other domains allowed to call the API (the GitHub Pages copy of the app).
    "ALLOWED_ORIGINS": "https://mmonceller.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quizgame",
      "database_id": "690c0475-985a-4c52-a955-417ce5f01170",
      "migrations_dir": "server/migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
